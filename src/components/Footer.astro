---
import SocialIcons from './SocialIcons.astro';

// Generate 20 pseudo-random deterministic stars
const stars = Array.from({ length: 20 }).map((_, i) => {
  const seed = (i * 7919 + 65537) % 233280;
  const rand1 = seed / 233280;
  const rand2 = ((seed * 7919 + 65537) % 233280) / 233280;
  const rand3 = (((seed + 1) * 7919 + 65537) % 233280) / 233280;
  const rand4 = (((seed + 2) * 7919 + 65537) % 233280) / 233280;
  const rand5 = (((seed + 3) * 7919 + 65537) % 233280) / 233280;

  return {
    id: i,
    top: `${rand1 * 100}%`,
    left: `${rand2 * 100}%`,
    size: rand3 * 2 + 1,
    duration: 2 + rand4 * 4,
    delay: rand5 * 5,
  };
});
---

<footer class="relative w-full border-t border-[var(--border-primary)] py-12 px-6 md:px-12 flex flex-col md:flex-row items-center justify-between font-mono text-[0.8125rem] text-[var(--text-secondary)] bg-[var(--bg-primary)] overflow-hidden transition-colors duration-300">
  {/* Starfield */}
  {stars.map((star) => (
    <div
      class="star-particle absolute bg-[var(--star-color)] rounded-full pointer-events-none z-0"
      style={`top: ${star.top}; left: ${star.left}; width: ${star.size}px; height: ${star.size}px; --star-duration: ${star.duration}s; --star-delay: ${star.delay}s;`}
    />
  ))}

  {/* Social Links - Left */}
  <div class="relative z-10 flex gap-6 md:w-1/3 justify-start items-center">
    <a href="https://github.com/hardikxk" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:opacity-70 transition-opacity duration-300 flex items-center justify-center" aria-label="GitHub">
      <SocialIcons name="github" size={16} />
    </a>
    <a href="https://www.linkedin.com/in/hardikxk/" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:opacity-70 transition-opacity duration-300 flex items-center justify-center" aria-label="LinkedIn">
      <SocialIcons name="linkedin" size={16} />
    </a>
    <a href="https://discord.com/users/1045297858821247036" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:opacity-70 transition-opacity duration-300 flex items-center justify-center" aria-label="Discord">
      <SocialIcons name="discord" size={16} />
    </a>
    <a href="https://x.com/hardikxk" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:opacity-70 transition-opacity duration-300 flex items-center justify-center" aria-label="X (formerly Twitter)">
      <SocialIcons name="x" size={16} />
    </a>
  </div>

  {/* Copyright / Info - Center */}
  <p class="relative z-10 text-center font-mono text-base md:text-lg font-bold tracking-wider text-[var(--text-primary)] md:w-1/3 my-4 md:my-0">
    Hardik Kumar
  </p>

  {/* Mail Button - Right */}
  <div class="relative z-10 md:w-1/3 flex justify-end">
    <a 
      href="mailto:hardikxk@gmail.com" 
      class="px-4 py-2 border border-[var(--border-primary)] hover:border-[var(--text-primary)] text-[var(--text-primary)] hover:bg-[var(--accent-invert-bg)] hover:text-[var(--accent-invert-text)] transition-all duration-300 bg-[var(--card-bg)] backdrop-blur-sm normal-case"
    >
      Send me an email
    </a>
  </div>
</footer>
