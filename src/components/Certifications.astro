<section id="certifications" class="bg-[var(--bg-primary)] py-16 sm:py-24 md:py-32 px-4 sm:px-6 lg:px-8 relative border-t border-[var(--border-primary)] transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 sm:gap-8 mb-8 sm:mb-12">
      <div>
        <div class="mb-3 sm:mb-4">
          <span class="font-mono text-xs sm:text-[0.6875rem] text-[var(--text-muted)]">[04]</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-5xl md:text-7xl font-black tracking-tight text-[var(--text-primary)] uppercase leading-[1.05]">
          CERTIFICATIONS &amp; CREDENTIALS
        </h2>
      </div>

      <div class="font-mono text-[0.625rem] sm:text-xs tracking-[0.15em] uppercase text-[var(--text-secondary)] border-l-2 border-[var(--text-primary)] pl-3 py-1 max-w-md">
        VERIFIED ACCREDITATIONS // CLOUD, DEVOPS, AI &amp; SYSTEMS
      </div>
    </div>

    {/* Filter Navigation Tabs */}
    <div class="flex flex-wrap gap-2 mb-8 sm:mb-12 border-b border-[var(--border-secondary)] pb-4 sm:pb-5">
      <button
        type="button"
        data-cert-filter="all"
        class="cert-filter-btn px-3 sm:px-3.5 py-1 font-mono text-[0.6rem] sm:text-[0.65rem] tracking-wider uppercase border transition-all duration-200 bg-[var(--accent-invert-bg)] text-[var(--accent-invert-text)] border-[var(--text-primary)] font-bold cursor-pointer"
      >
        ALL ({certifications.length})
      </button>
      <button
        type="button"
        data-cert-filter="cloud"
        class="cert-filter-btn px-3 sm:px-3.5 py-1 font-mono text-[0.6rem] sm:text-[0.65rem] tracking-wider uppercase border transition-all duration-200 bg-[var(--card-bg)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)] cursor-pointer"
      >
        CLOUD &amp; DEVOPS ({certifications.filter(c => c.category === 'cloud').length})
      </button>
      <button
        type="button"
        data-cert-filter="ai"
        class="cert-filter-btn px-3 sm:px-3.5 py-1 font-mono text-[0.6rem] sm:text-[0.65rem] tracking-wider uppercase border transition-all duration-200 bg-[var(--card-bg)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)] cursor-pointer"
      >
        AI &amp; DATA ({certifications.filter(c => c.category === 'ai').length})
      </button>
      <button
        type="button"
        data-cert-filter="systems"
        class="cert-filter-btn px-3 sm:px-3.5 py-1 font-mono text-[0.6rem] sm:text-[0.65rem] tracking-wider uppercase border transition-all duration-200 bg-[var(--card-bg)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)] cursor-pointer"
      >
        SYSTEMS &amp; APIS ({certifications.filter(c => c.category === 'systems').length})
      </button>
    </div>

    {/* Certifications Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {certifications.map((cert) => (
        <div
          class="cert-card group bg-[var(--card-bg)] border border-[var(--border-primary)] p-5 sm:p-6 relative flex flex-col justify-between hover:border-[var(--text-primary)] transition-all duration-300 shadow-[4px_4px_0px_0px_var(--shadow-color)] sm:shadow-[6px_6px_0px_0px_var(--shadow-color)]"
          data-category={cert.category}
        >
          {/* Corner Accents */}
          <div class="absolute -top-1 -left-1 w-2 h-2 border-t-2 border-l-2 border-[var(--text-primary)]"></div>
          <div class="absolute -bottom-1 -right-1 w-2 h-2 border-b-2 border-r-2 border-[var(--text-primary)]"></div>

          <div>
            {/* Header: ID, Category & Issuer */}
            <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 mb-3.5 pb-2.5 border-b border-[var(--border-secondary)]">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="font-mono text-xs sm:text-[0.6875rem] font-bold text-[var(--text-muted)] shrink-0">
                  [{cert.id}]
                </span>
                <span class="inline-flex items-center w-fit max-w-fit shrink-0 whitespace-nowrap font-mono text-[0.5rem] sm:text-[0.55rem] tracking-wider uppercase px-1.5 py-0.5 bg-[var(--bg-primary)] border border-[var(--border-secondary)] text-[var(--text-primary)] font-semibold leading-none">
                  {cert.categoryLabel}
                </span>
              </div>

              <div class="font-mono text-[0.55rem] sm:text-[0.6rem] font-semibold text-[var(--text-secondary)] text-right shrink-0">
                {cert.issuer}
              </div>
            </div>

            {/* Title & Badge Thumbnail */}
            <div class="flex items-start gap-3.5 mb-2">
              <div class="w-12 h-12 sm:w-13 sm:h-13 shrink-0 bg-[var(--bg-primary)] border border-[var(--border-secondary)] p-1.5 flex items-center justify-center overflow-hidden">
                <img
                  src={cert.badgeImage}
                  alt={`${cert.title} badge`}
                  class="w-full h-full object-contain filter group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="font-serif text-base sm:text-[1.05rem] lg:text-[1.125rem] font-bold text-[var(--text-primary)] tracking-tight leading-[1.35] group-hover:text-[var(--text-primary)] transition-colors">
                  {cert.title}
                </h3>

                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 mt-2 font-mono text-[0.575rem] sm:text-[0.625rem] text-[var(--text-muted)]">
                  <span>Issued: {cert.issued}</span>
                  {cert.validUntil && (
                    <>
                      <span>•</span>
                      <span>Valid: {cert.validUntil}</span>
                    </>
                  )}
                </div>
              </div>
            </div>
          </div>

          <div>
            {/* Verification Link */}
            <div class="pt-3 mt-4 border-t border-[var(--border-secondary)] flex justify-end">
              <a
                href={cert.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-[var(--border-primary)] hover:border-[var(--text-primary)] bg-[var(--bg-primary)] hover:bg-[var(--accent-invert-bg)] hover:text-[var(--accent-invert-text)] font-mono text-[0.575rem] sm:text-[0.625rem] font-bold tracking-wider uppercase transition-all duration-200 text-[var(--text-primary)]"
                aria-label={`Verify ${cert.title} on official issuer portal`}
              >
                <span>VERIFY BADGE</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupCertFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.cert-filter-btn');
    const certCards = document.querySelectorAll<HTMLElement>('.cert-card');

    if (!filterButtons.length || !certCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-cert-filter');

        // Update active button state
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[var(--accent-invert-bg)]', 'text-[var(--accent-invert-text)]', 'font-bold');
          b.classList.add('bg-[var(--card-bg)]', 'text-[var(--text-secondary)]');
        });
        btn.classList.add('bg-[var(--accent-invert-bg)]', 'text-[var(--accent-invert-text)]', 'font-bold');
        btn.classList.remove('bg-[var(--card-bg)]', 'text-[var(--text-secondary)]');

        // Filter cards
        certCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupCertFilter();
  document.addEventListener('astro:page-load', setupCertFilter);
</script>
